# Local LLM via Ollama - no API keys, data never leaves your machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
DB_PATH=data/ops.db
MAX_RETRIES=2
MAX_ROWS=200
# Observability (optional). LangSmith is a cloud service - keep false for fully offline runs.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sql-agent-poc
